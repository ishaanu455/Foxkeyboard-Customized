<?xml version="1.0" encoding="utf-8"?>
<!-- Flat pressable row background for the vertical Cut/Copy/Paste/Select-all
     menu on the right of the redesigned text editor panel. Transparent at
     rest so the row reads as part of the panel surface, filled on press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/keyFunctionPressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
