<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/key_background_function"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/clip_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:ellipsize="end"
        android:textSize="15sp"
        android:textColor="?attr/foreground"
        tools:text="Copied clip text goes here" />

    <LinearLayout
        android:id="@+id/clip_actions"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/clip_pin"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_clip_pin"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/clip_pin" />

        <ImageView
            android:id="@+id/clip_share"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_clip_share"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/clip_share" />

        <ImageView
            android:id="@+id/clip_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_clip_delete"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/clip_delete" />

    </LinearLayout>

</LinearLayout>
