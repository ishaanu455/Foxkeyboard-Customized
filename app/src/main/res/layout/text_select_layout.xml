<?xml version="1.0" encoding="utf-8"?>
<!-- Redesigned text-editor panel: a title bar (back + "Text Editor"), a
     cursor cross (up / left-SELECT-right / down) on the left with a
     dedicated Cut/Copy/Paste/Select-all menu column on the right, and a
     bottom bar with jump-to-start/jump-to-end plus backspace. All view IDs
     are unchanged from the previous layout so the click listeners already
     wired in KeyboardView.kt keep working as-is - only the arrangement and
     visual style changed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/fox_background"
    tools:ignore="ContentDescription">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/btn_ts_abc"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_top_bar_icon_circle"
            android:contentDescription="@string/keyboard_view" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/text_editor_title"
            android:textSize="17sp"
            android:textColor="?attr/foreground"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Main content: cursor cross on the left, menu column on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btn_ts_up"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_up"
                android:background="@drawable/bg_text_select_cursor_btn"
                android:contentDescription="@string/text_select_up" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btn_ts_left"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_keyboard_arrow_left"
                    android:background="@drawable/bg_text_select_cursor_btn"
                    android:contentDescription="@string/text_select_left" />

                <TextView
                    android:id="@+id/btn_ts_toggle_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_text_select_pill"
                    android:text="@string/text_select_toggle"
                    android:textSize="14sp"
                    android:textColor="?attr/foreground"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/btn_ts_right"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_keyboard_arrow_right"
                    android:background="@drawable/bg_text_select_cursor_btn"
                    android:contentDescription="@string/text_select_right" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_ts_down"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_down"
                android:background="@drawable/bg_text_select_cursor_btn"
                android:contentDescription="@string/text_select_down" />

        </LinearLayout>

        <!-- Right-side Cut/Copy/Paste/Select-all menu column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:orientation="vertical"
            android:background="@drawable/bg_text_select_side_panel">

            <TextView
                android:id="@+id/btn_ts_cut"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_text_select_menu_item"
                android:text="@string/text_select_cut"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:textColor="?attr/foreground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/border" />

            <TextView
                android:id="@+id/btn_ts_copy"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_text_select_menu_item"
                android:text="@string/text_select_copy"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:textColor="?attr/foreground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/border" />

            <TextView
                android:id="@+id/btn_ts_paste"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_text_select_menu_item"
                android:text="@string/text_select_paste"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:textColor="?attr/foreground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/border" />

            <TextView
                android:id="@+id/btn_ts_select_all"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_text_select_menu_item"
                android:text="@string/text_select_all"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:textColor="?attr/foreground" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom bar: jump-to-start / jump-to-end on the left, backspace on the right -->
    <LinearLayout
        android:id="@+id/textSelectBottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/btn_ts_word_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:background="@drawable/key_background_function"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_double_left"
            android:contentDescription="@string/text_select_word_left" />

        <ImageView
            android:id="@+id/btn_ts_word_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:layout_marginStart="4dp"
            android:background="@drawable/key_background_function"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_double_right"
            android:contentDescription="@string/text_select_word_right" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6" />

        <ImageView
            android:id="@+id/btn_ts_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/key_background_function"
            android:contentDescription="@string/backspace"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_backspace" />

    </LinearLayout>

</LinearLayout>
