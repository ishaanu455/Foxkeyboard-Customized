<?xml version="1.0" encoding="utf-8"?>
<!-- Original text-selection panel design (not a copy of any reference UI):
     a compact Cut/Copy/Paste/Select-all pill row, a single-row cursor cluster
     (word-left, left, up/down select-toggle stack, right, word-right) sized
     and colored to match the rest of the keyboard's key language, and a
     bottom bar reusing the same abc/backspace pattern as the emoji panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/fox_background"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:id="@+id/text_select_pill_row"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingTop="6dp">

        <LinearLayout
            android:id="@+id/btn_ts_cut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_text_select_pill">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_cut"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_select_cut"
                android:textSize="11sp"
                android:textColor="?attr/foreground"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_ts_copy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_text_select_pill">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_copy"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_select_copy"
                android:textSize="11sp"
                android:textColor="?attr/foreground"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_ts_paste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_text_select_pill">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_clipboard"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_select_paste"
                android:textSize="11sp"
                android:textColor="?attr/foreground"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_ts_select_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_text_select_pill">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_select_all"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_select_all"
                android:textSize="11sp"
                android:textColor="?attr/foreground"
                android:includeFontPadding="false" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/text_select_cluster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_text_select_cluster">

            <ImageView
                android:id="@+id/btn_ts_word_left"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_double_left"
                android:background="@drawable/bg_text_select_cursor_btn"
                android:contentDescription="@string/text_select_word_left" />

            <ImageView
                android:id="@+id/btn_ts_left"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard_arrow_left"
                android:background="@drawable/bg_text_select_cursor_btn"
                android:contentDescription="@string/text_select_left" />

            <LinearLayout
                android:layout_width="46dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btn_ts_up"
                    android:layout_width="46dp"
                    android:layout_height="28dp"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_up"
                    android:background="@drawable/bg_text_select_cursor_btn"
                    android:contentDescription="@string/text_select_up" />

                <TextView
                    android:id="@+id/btn_ts_toggle_select"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="2dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_text_select_pill"
                    android:text="@string/text_select_toggle"
                    android:textSize="10sp"
                    android:textColor="?attr/foreground_2"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/btn_ts_down"
                    android:layout_width="46dp"
                    android:layout_height="28dp"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_down"
                    android:background="@drawable/bg_text_select_cursor_btn"
                    android:contentDescription="@string/text_select_down" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_ts_right"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard_arrow_right"
                android:background="@drawable/bg_text_select_cursor_btn"
                android:contentDescription="@string/text_select_right" />

            <ImageView
                android:id="@+id/btn_ts_word_right"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_double_right"
                android:background="@drawable/bg_text_select_cursor_btn"
                android:contentDescription="@string/text_select_word_right" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/textSelectBottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_ts_abc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/key_background_function"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard"
            android:contentDescription="@string/keyboard_view" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7" />

        <ImageView
            android:id="@+id/btn_ts_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/key_background_function"
            android:contentDescription="@string/backspace"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_backspace" />

    </LinearLayout>

</LinearLayout>
