<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/fox_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/btn_clipboard_abc"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:background="@drawable/bg_clip_purple_circle"
            android:src="@drawable/ic_keyboard_arrow_left"
            android:tint="@android:color/white"
            android:contentDescription="@string/clipboard_title" />

        <TextView
            android:id="@+id/clipboard_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/clipboard_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/foreground" />

        <ImageView
            android:id="@+id/clip_clear_all"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:background="@drawable/bg_clip_purple_circle"
            android:src="@drawable/ic_clip_delete"
            android:tint="@android:color/white"
            android:contentDescription="@string/clipboard_clear" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/clipboard_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="2dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/clipboard_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="@string/clipboard_empty"
            android:textSize="14sp"
            android:textColor="?attr/foreground_2"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
